layout {
    border {
        on
        width 1
        active-color "#d070e5"
        inactive-color "#702d7f"
        urgent-color "#9b0000"
    }

    gaps 4

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        on
        width 1
        active-color "#d070e5"
        inactive-color "#702d7f"
    }
}
